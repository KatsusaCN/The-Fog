   1          #include"ds1302.h"
   2          //---DS1302写入和读取时分秒的地址命令---//
   3          //---秒分时日月周年 最低位读写位;-------//
   4          uchar code READ_RTC_ADDR[7] = {0x81, 0x83, 0x85, 0x87, 0x89, 0x8b, 0x8d}; 
   5          uchar code WRITE_RTC_ADDR[7] = {0x80, 0x82, 0x84, 0x86, 0x88, 0x8a, 0x8c};
   6          
   7          //---DS1302时钟初始化2026年11月5日星期3 11点59分05秒。---//
   8          //---存储顺序是秒分时日月周年,存储格式是用BCD码---//
   9          uchar code TIME[7] = {0x59, 0x59, 0x21, 0x04, 0x09, 0x04, 0x25};
  10          unsigned char idata EasterEgg=0;
  11           /*******************************************************************************
  12          * 函 数 名         : Ds1302WriteByte
  13          * 函数功能       : 向DS1302命令字节
  14          * 输    入         : addr,dat
  15          * 输    出         : 无
  16          *******************************************************************************/
  17          
  18          void DS1302WriteByte(unsigned char dat)
  19          { 
  20   1        unsigned char i;
  21   1        for (i=0;i<8;i++)
  22   1          { 
  23   2            DSIO=dat & 0x01;    //低位在前
  24   2            dat>>=1;
  25   2            SCLK = 1;_nop_();//数据在上升沿时，DS1302读取数据
  26   2            SCLK = 0;_nop_();
  27   2          }
  28   1      }
  29          
  30          /*******************************************************************************
  31          * 函 数 名         : Ds1302ReadByte
  32          * 函数功能       : 向DS1302读字节
  33          * 输    入         : addr,dat
  34          * 输    出         : 无
  35          *******************************************************************************/
  36           unsigned char DS1302ReadByte()
  37          { 
  38   1        unsigned char n;
  39   1        uchar dat1,dat;
  40   1        for(n=0; n<8; n++)//读取8位数据
  41   1        {
  42   2          dat1 = DSIO;//从最低位开始接收
  43   2          dat = (dat>>1) | (dat1<<7);
  44   2          SCLK = 1;_nop_();
  45   2          SCLK = 0;_nop_();//DS1302下降沿时，放置数据
  46   2        }
  47   1        return dat;
  48   1      }
  49          
  50          /*******************************************************************************
  51          * 函 数 名         : Ds1302Write
  52          * 函数功能       : 向DS1302命令（地址+数据）
  53          * 输    入         : addr,dat
  54          * 输    出         : 无
C51 COMPILER V9.60.7.0   DS1302                                                            11/17/2026 13:33:21 PAGE 2   

  55          *******************************************************************************/
  56          
  57          void Ds1302Write(uchar addr, uchar dat)
  58          {
  59   1        RST = 0;_nop_();
  60   1        SCLK = 0;_nop_();//先将SCLK置低电平。
  61   1        RST = 1;_nop_(); //然后将RST(CE)置高电平。
  62   1        DS1302WriteByte(addr);//写入8位命令
  63   1        DS1302WriteByte(dat);// 写入8位数据
  64   1        RST = 0;_nop_();//传送数据结束
  65   1      }
  66          
  67          /*******************************************************************************
  68          * 函 数 名         : Ds1302Read
  69          * 函数功能       : 读取一个地址的数据
  70          * 输    入         : addr
  71          * 输    出         : dat
  72          *******************************************************************************/
  73          
  74          uchar Ds1302Read(uchar addr)
  75          {
  76   1        uchar dat2;
  77   1        RST = 0;_nop_();
  78   1        SCLK = 0;_nop_();//先将SCLK置低电平。
  79   1        RST = 1;_nop_();//然后将RST(CE)置高电平。
  80   1        DS1302WriteByte(addr);_nop_();//写入8位地址命令
  81   1        DSIO = 1;_nop_();//MCU释放I/O
  82   1        dat2=DS1302ReadByte();
  83   1        RST = 0;_nop_();  //以下为DS1302复位的稳定时间,必须的。
  84   1        SCLK = 1;_nop_();
  85   1        DSIO = 0;_nop_();
  86   1        DSIO = 1;_nop_();
  87   1        return dat2;  ///返回得到的时间/日期
  88   1      }
  89          
  90          /*******************************************************************************
  91          * 函 数 名         : Ds1302Init
  92          * 函数功能       : 初始化DS1302.
  93          * 输    入         : 无
  94          * 输    出         : 无
  95          *******************************************************************************/
  96          
  97          unsigned char DataLoad()
  98          {
  99   1        unsigned char m,n;
 100   1        m=Ds1302Read(0xC1);  //根据Ds1302内31个字节RAM,首次上电时RAM中值为0xFF
 101   1        Ds1302Write(0x8E,0X00);    //禁止写保护，就是关闭写保护功能
 102   1        if(m>0x06 || m==0)   // RAM 表示没掉电过
 103   1        {
 104   2          for (n=0; n<7; n++)//写入7个字节的时钟信号：分秒时日月周年
 105   2          {
 106   3            Ds1302Write(WRITE_RTC_ADDR[n],TIME[n]); 
 107   3          }
 108   2          Ds1302Write(0xC0,0x00); //写入RAM中没掉电的标记，掉电时为0xFF
 109   2          //Ds1302Write(0x8E,0x80);    //打开写保护功能
 110   2          return 0;
 111   2        }
 112   1        return m;
 113   1      }


